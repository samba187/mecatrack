# ── Mécatrack — variables d'environnement ──────────────────────────────────
# Sans aucune clé, l'application démarre en MODE DÉMO (données fictives en
# mémoire, aucune authentification) : pratique pour développer et faire une
# démonstration du produit.

# Mode démo forcé même si Supabase est configuré (optionnel)
# NEXT_PUBLIC_DEMO=true

# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ESSENTIEL=
STRIPE_PRICE_ID_PRO=

# Twilio — SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend — emails transactionnels (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Mécatrack <notifications@mecatrack.com>"

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000
