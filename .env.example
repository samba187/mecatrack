# ── Fiavo — variables d'environnement ──────────────────────────────────────
# Sans aucune clé, l'application démarre en MODE DÉMO (données fictives en
# mémoire, aucune authentification) : pratique pour développer et faire une
# démonstration du produit.

# Mode démo forcé même si Supabase est configuré (optionnel)
# NEXT_PUBLIC_DEMO=true

# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ATELIER=
STRIPE_PRICE_ID_PRO=

# ── SMS ────────────────────────────────────────────────────────────────────
# Nom affiché comme expéditeur sur le téléphone du client.
# 11 caractères alphanumériques max (accents/espaces retirés automatiquement).
SMS_SENDER_ID=Fiavo

# Fournisseur 1 (recommandé) — Brevo : tarif France plus bas que Twilio.
# https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=

# Fournisseur 2 (repli) — Twilio, utilisé seulement si BREVO_API_KEY est vide.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Expéditeur Twilio : identifiant alphanumérique (gratuit en France) ou numéro loué.
TWILIO_SENDER_ID=
TWILIO_PHONE_NUMBER=

# Resend — emails transactionnels (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Fiavo <notifications@fiavo.fr>"

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000
